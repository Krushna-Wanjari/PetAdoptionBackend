# Copy this file to .env and fill in your own values.
# .env is gitignored and is loaded automatically by Spring Boot.

# ---------- MySQL ----------
DB_USER=root
DB_PASS=your-mysql-password

# ---------- JWT ----------
# Must be at least 32 characters (HS256 requires a 256-bit key).
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# ---------- Cloudinary (pet image uploads) ----------
# Dashboard -> https://console.cloudinary.com/
# Leave blank to run without image uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- Seeded admin account ----------
ADMIN_EMAIL=admin@petadoption.com
ADMIN_PASSWORD=change-this-password
